generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  salePrice     Decimal? @db.Decimal(10, 2)
  sku           String?  @unique
  brand         String?
  stock         Int      @default(0)
  reservedStock Int      @default(0)
  active        Boolean  @default(true)
  featured      Boolean  @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  audience    String?
  productType String?
  frameUse    String?
  frameShape  String?
  color       String?

  brandId  String?
  brandRef Brand?  @relation(fields: [brandId], references: [id])

  images         ProductImage[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  costPrice    Decimal? @db.Decimal(10, 2)
  minimumStock Int      @default(0)

  frameDetails FrameDetails?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id String @id @default(uuid())

  name String
  slug String @unique

  description String?
  logoUrl     String?
  website     String?

  active Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  active      Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  publicId String?
  alt      String?
  position Int     @default(0)
  isMain   Boolean @default(false)

  createdAt DateTime @default(now())
}

model Supplier {
  id String @id @default(uuid())

  code String @unique
  name String

  contactName String?
  phone       String?
  email       String?

  active Boolean @default(true)

  frames FrameDetails[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCollection {
  id String @id @default(uuid())

  code        String  @unique
  name        String
  description String?

  active Boolean @default(true)

  frames FrameDetails[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FrameDetails {
  id String @id @default(uuid())

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  collectionId String?
  collection   ProductCollection? @relation(fields: [collectionId], references: [id])

  supplierCode String?
  internalCode String  @unique
  modelCode    String

  publicBrand String @default("Ótica Show Room")

  audience String
  material String
  shape    String

  primaryColor   String
  secondaryColor String?
  finish         String?

  lensWidth    Int?
  bridgeWidth  Int?
  templeLength Int?
  sizeLabel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([collectionId])
  @@index([audience])
  @@index([material])
  @@index([shape])
  @@index([primaryColor])
}

model Customer {
  id    String @id @default(uuid())
  name  String
  email String
  phone String

  crmStatus String @default("lead")

  cpf       String?
  birthDate DateTime?

  zipcode    String
  state      String
  street     String
  number     String
  complement String?
  district   String
  city       String

  lgpdAcceptedAt    DateTime?
  lgpdConsentSource String?

  attendances CustomerAttendance[]

  orders    Order[]
  notes     CustomerNote[]
  reminders CustomerReminder[]

  interactions CustomerInteraction[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  opticalPrescriptions OpticalPrescription[]

  @@index([phone])
}

model Order {
  id          String  @id @default(uuid())
  orderNumber String? @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status   String  @default("pending")
  subtotal Decimal @db.Decimal(10, 2)
  notes    String?

  paymentStatus     String    @default("pending")
  paymentMethod     String?
  paymentProvider   String?
  paymentProviderId String?
  paymentUrl        String?
  paidAt            DateTime?

  shippingMethod String?
  shippingPrice  Decimal? @db.Decimal(10, 2)
  shippingStatus String?  @default("not_required")

  attendanceId String?
  attendance   CustomerAttendance? @relation(fields: [attendanceId], references: [id])

  createdByAdminId String?
  createdByAdmin   AdminUser? @relation("OrderCreatedByAdmin", fields: [createdByAdminId], references: [id])

  items          OrderItem[]
  paymentEvents  OrderPaymentEvent[]
  stockMovements StockMovement[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  laboratoryOrders LaboratoryOrder[]
}

model OrderPaymentEvent {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  eventType String
  status    String

  amount Decimal? @db.Decimal(10, 2)

  method    String?
  provider  String?
  reference String?

  installments Int?

  notes  String?
  reason String?

  occurredAt DateTime @default(now())

  adminId    String?
  adminEmail String?
  adminRole  String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  createdAt DateTime @default(now())
}

model AdminUser {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  role         String  @default("owner")
  active       Boolean @default(true)

  createdOrders Order[] @relation("OrderCreatedByAdmin")

  createdLaboratoryOrders LaboratoryOrder[]    @relation("LaboratoryOrderCreatedByAdmin")
  createdAttendances      CustomerAttendance[] @relation("AttendanceCreatedByAdmin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteRequest {
  id String @id @default(uuid())

  customerName  String
  customerEmail String?
  customerPhone String

  requestType      String
  prescriptionText String?
  notes            String?

  prescriptionFileUrl  String?
  prescriptionPublicId String?

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id String @id @default(uuid())

  adminId    String?
  adminEmail String?
  adminRole  String?

  action   String
  entity   String
  entityId String?

  metadata Json?

  createdAt DateTime @default(now())
}

model AdminLoginSecurity {
  id String @id @default(uuid())

  email          String    @unique
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  lastFailedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model StorefrontHeroSlide {
  id                  String  @id @default(uuid())
  kicker              String
  title               String
  description         String
  imageUrl            String
  primaryAction       String
  primaryActionHref   String  @default("/produtos")
  secondaryAction     String
  secondaryActionHref String  @default("/orcamento")
  position            Int     @default(0)
  active              Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StorefrontBanner {
  id            String  @id @default(uuid())
  key           String  @unique
  kicker        String
  title         String
  description   String
  buttonLabel   String
  buttonHref    String
  imageUrl      String?
  imagePosition String? @default("center")
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StorefrontTheme {
  id  String @id @default(uuid())
  key String @unique @default("default")

  primaryColor   String @default("#6F330B")
  secondaryColor String @default("#E75900")
  accentColor    String @default("#B8914B")

  backgroundColor String @default("#F9F4EF")
  surfaceColor    String @default("#FFFFFF")
  titleColor      String @default("#2C2520")
  textColor       String @default("#7F7169")
  borderColor     String @default("#E7D8CC")
  buttonTextColor String @default("#FFFFFF")

  bannerContentOpacity Int @default(68)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id String @id @default(uuid())

  title       String
  description String?

  imageUrl           String?
  cloudinaryPublicId String?

  buttonText String?
  buttonLink String?

  location String

  active Boolean @default(true)

  showDelay    Int     @default(3)
  showOnlyOnce Boolean @default(true)

  startDate DateTime?
  endDate   DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id String @id @default(uuid())

  title String
  slug  String @unique

  excerpt String
  content Json

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  imageUrl           String?
  cloudinaryPublicId String?

  readingTime String?

  featured Boolean @default(false)

  published Boolean @default(false)

  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model BlogCategory {
  id String @id @default(uuid())

  name String
  slug String @unique

  description String?

  position Int @default(0)

  active Boolean @default(true)

  posts BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerNote {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  note String

  createdAt DateTime @default(now())
}

model CustomerReminder {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type String

  title String

  dueDate DateTime

  completed Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model CustomerInteraction {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type String

  description String

  createdAt DateTime @default(now())
}

model Widget {
  id String @id @default(uuid())

  name String

  type String
  // IMAGE | VIDEO | EMBED | HTML

  position String
  // BLOG_SIDEBAR
  // BLOG_ARTICLE
  // HOME

  title String?

  description String?

  mediaUrl String?

  redirectUrl String

  buttonLabel String?

  aspectRatio String @default("16:9")
  // 1:1
  // 16:9
  // 9:16
  // custom

  active Boolean @default(true)

  order Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Laboratory {
  id String @id @default(uuid())

  code String? @unique

  name        String
  companyName String?

  phone    String?
  whatsapp String?
  email    String?
  website  String?

  contactName String?

  averageDeliveryDays Int?

  acceptsApi Boolean @default(false)

  city  String?
  state String?

  notes String?

  active Boolean @default(true)

  laboratoryOrders LaboratoryOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OpticalPrescription {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  examDate  DateTime?
  expiresAt DateTime?

  rightSpherical   String?
  rightCylindrical String?
  rightAxis        String?

  leftSpherical   String?
  leftCylindrical String?
  leftAxis        String?

  addition          String?
  pupillaryDistance String?
  height            String?

  doctorName String?
  doctorCrm  String?

  notes String?

  fileUrl      String?
  filePublicId String?

  laboratoryOrders LaboratoryOrder[]
  attendances      CustomerAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerAttendance {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdByAdminId String?
  createdByAdmin   AdminUser? @relation("AttendanceCreatedByAdmin", fields: [createdByAdminId], references: [id])

  type String
  // complete_glasses
  // lenses_only
  // frame_only
  // adjustment
  // warranty
  // repair
  // review

  status String @default("open")
  // open
  // in_progress
  // converted_to_order
  // completed
  // cancelled

  notes String?

  orders Order[]

  prescriptionId String?
  prescription   OpticalPrescription? @relation(fields: [prescriptionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LaboratoryOrder {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  laboratoryId String
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id])

  prescriptionId String?
  prescription   OpticalPrescription? @relation(fields: [prescriptionId], references: [id])

  externalOrderNumber String?

  createdByAdminId String?
  createdByAdmin   AdminUser? @relation("LaboratoryOrderCreatedByAdmin", fields: [createdByAdminId], references: [id])

  status String @default("pending")
  // pending
  // sent
  // received_by_laboratory
  // in_production
  // ready
  // received_at_store
  // mounted
  // delivered

  sentAt      DateTime?
  expectedAt  DateTime?
  receivedAt  DateTime?
  deliveredAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockMovement {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  movementType String

  quantity Int

  stockBefore    Int
  stockAfter     Int
  reservedBefore Int
  reservedAfter  Int

  reason    String?
  reference String?

  adminId    String?
  adminEmail String?
  adminRole  String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([orderId])
  @@index([movementType])
  @@index([createdAt])
}
